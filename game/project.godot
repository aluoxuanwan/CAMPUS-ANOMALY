[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player_body"
2d_physics/layer_3="enemy_body"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_attack"
2d_physics/layer_7="enemy_attack"
2d_physics/layer_8="player_projectile"
2d_physics/layer_9="enemy_projectile"
2d_physics/layer_10="pickup"
2d_physics/layer_11="cover"
2d_physics/layer_12="cover_hurtbox"

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.13, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
